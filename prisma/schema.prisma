// Enterprise TMS Schema — 丸市倉庫株式会社 Transport Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum CompanyType {
  MARUICHI
  SHINWA
  SUBCONTRACTOR
  FACTORY
}

enum UserRole {
  MARUICHI_STAFF
  SHINWA_STAFF
  SUBCONTRACTOR_STAFF
  DRIVER
  FACTORY_STAFF
}

enum OrderStatus {
  PENDING
  SHINWA_ACCEPTED
  SUBCONTRACTED
  SPLIT
  DRIVER_ASSIGNED
  DISPATCHED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  AWAITING_CONFIRMATION
  DELIVERED
  CANCELLED
}

enum DeliveryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TruckType {
  MEDIUM
  TEN_TON
}

enum AssignmentStatus {
  PENDING
  ASSIGNED
  DISPATCHED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CANCELLED
}

enum TruckStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OFFLINE
}

enum DriverStatus {
  AVAILABLE
  DRIVING
  BREAK
  OFFLINE
}

enum LicenseType {
  STANDARD
  MEDIUM
  LARGE
  TRAILER
}

enum NotificationType {
  NEW_REQUEST
  ORDER_ACCEPTED
  ORDER_REJECTED
  DRIVER_ASSIGNED
  TRUCK_ASSIGNED
  STATUS_UPDATE
  SUBCONTRACT_ASSIGNED
  DELIVERY_SPLIT
  GPS_UPDATE
  DELIVERY_COMPLETE
  CUSTOMER_CONFIRMED
  ARRIVED_AT_DESTINATION
}

enum SplitStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

// Legacy alias — maps to TruckType in application layer
enum VehicleType {
  SMALL_TRUCK
  MEDIUM_TRUCK
  LARGE_TRUCK
  TRAILER
  REFRIGERATED
}

// ─── Core Entities ───────────────────────────────────────────────────────────

model Company {
  id        String      @id @default(cuid())
  name      String
  type      CompanyType
  address   String?
  phone     String?
  email     String?
  latitude  Float?
  longitude Float?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  users                  User[]
  warehouses             Warehouse[]
  createdRequests        TransportRequest[]      @relation("RequestCreator")
  handledRequests        TransportRequest[]      @relation("RequestHandler")
  subcontractAssignments SubContractAssignment[]
  trucks                 Truck[]
  vehicles               Vehicle[]
  drivers                Driver[]
  deliverySplits         DeliverySplit[]
  factoryRequestsFrom    FactoryRequest[] @relation("FactoryRequestWarehouse")
  factoryRequestsTo      FactoryRequest[] @relation("FactoryRequestFactory")
  yokomochiTrips           YokomochiTrip[]
  carrierRequests          CarrierRequest[] @relation("CarrierRequestWarehouse")
  carrierRequestsHandling  CarrierRequest[] @relation("CarrierRequestCarrier")
  yokomochiSubcontracts    YokomochiSubcontractAssignment[]

  @@index([type])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  companyId    String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  notifications Notification[]
  driver        Driver?
  passwordResetTokens PasswordResetToken[]

  factoryRequestsCreated FactoryRequest[] @relation("FactoryRequestCreator")
  negotiationActions     NegotiationHistory[]
  negotiationChatMessages NegotiationChatMessage[] @relation("NegotiationChatSender")

  @@index([companyId])
  @@index([role])
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String
  latitude  Float
  longitude Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company            @relation(fields: [companyId], references: [id])
  transportRequests TransportRequest[]

  @@index([companyId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportRequests TransportRequest[]

  @@index([name])
}

model Product {
  id                   String   @id @default(cuid())
  sku                  String   @unique
  name                 String
  unitWeight           Float
  unitVolume           Float
  category             String?
  fragile              Boolean  @default(false)
  temperatureControlled Boolean @default(false)
  companyId            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  deliveryItems DeliveryItem[]

  @@index([sku])
  @@index([category])
}

// ─── Delivery (TransportRequest) ─────────────────────────────────────────────

model TransportRequest {
  id                 String           @id @default(cuid())
  requestNo          String           @unique
  origin             String
  destination        String
  cargoType          String?
  cargoWeight        Float            @default(0)
  cargoVolume        Float            @default(0)
  totalQuantity      Int              @default(0)
  vehicleType        VehicleType?
  vehicleCount       Int              @default(1)
  expectedPickupDate DateTime
  deliveryDate       DateTime?
  priority           DeliveryPriority @default(NORMAL)
  status             OrderStatus      @default(PENDING)
  estimatedCost      Float?
  actualCost         Float?
  notes              String?
  proofImageUrl      String?
  deliveryPhotoUrl   String?
  creatorCompanyId   String
  createdById        String?
  handlerCompanyId   String?
  warehouseId        String?
  customerId         String?
  parentRequestId    String?
  suggestedTruckType TruckType?
  suggestedTruckCount Int?
  routePolyline      String?
  routeDistanceKm    Float?
  routeDurationMin   Float?
  eta                DateTime?
  originLat          Float?
  originLng          Float?
  destLat            Float?
  destLng            Float?
  progressPercent    Float            @default(0)
  onTime             Boolean?
  fuelEstimateLiters Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deliveredAt        DateTime?
  arrivedAt          DateTime?

  creatorCompany        Company                @relation("RequestCreator", fields: [creatorCompanyId], references: [id])
  handlerCompany        Company?               @relation("RequestHandler", fields: [handlerCompanyId], references: [id])
  warehouse             Warehouse?             @relation(fields: [warehouseId], references: [id])
  customer              Customer?              @relation(fields: [customerId], references: [id])
  parentRequest         TransportRequest?      @relation("DeliverySplit", fields: [parentRequestId], references: [id])
  childRequests         TransportRequest[]     @relation("DeliverySplit")
  deliveryItems         DeliveryItem[]
  subContractAssignment SubContractAssignment?
  tripAllocation        TripAllocation?
  truckAssignments      TruckAssignment[]
  deliverySplits        DeliverySplit[]
  notifications         Notification[]
  deliveryConfirmation  DeliveryConfirmation?
  proofOfDelivery       ProofOfDelivery?
  gpsHistory            GpsHistory[]

  @@index([status])
  @@index([creatorCompanyId])
  @@index([handlerCompanyId])
  @@index([customerId])
  @@index([parentRequestId])
  @@index([createdAt])
  @@index([expectedPickupDate])
  @@index([priority])
}

model DeliveryItem {
  id                 String   @id @default(cuid())
  transportRequestId String
  productId          String
  quantity           Int
  totalWeight        Float
  totalVolume        Float
  createdAt          DateTime @default(now())

  transportRequest TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])

  @@index([transportRequestId])
  @@index([productId])
}

model DeliverySplit {
  id                 String      @id @default(cuid())
  transportRequestId String
  companyId          String
  assignedWeightKg   Float
  assignedVolumeM3   Float
  status             SplitStatus @default(PENDING)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  transportRequest TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  company          Company          @relation(fields: [companyId], references: [id])

  @@index([transportRequestId])
  @@index([companyId])
}

// ─── Fleet ───────────────────────────────────────────────────────────────────

model Truck {
  id                String      @id @default(cuid())
  truckNumber       String      @unique
  truckNo           String?     @unique
  truckType         TruckType
  plateNumber       String      @unique
  capacityWeightKg  Float
  capacityVolumeM3  Float
  maxBoxes          Int         @default(0)
  maxPallet         Int         @default(0)
  status            TruckStatus @default(AVAILABLE)
  companyId         String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  tripAllocations  TripAllocation[]
  truckAssignments TruckAssignment[]
  internalFleetAssignments InternalFleetAssignment[]
  driverSchedules  DriverSchedule[]
  driverTasks      DriverTask[]

  @@index([companyId])
  @@index([status])
  @@index([truckType])
}

model TruckAssignment {
  id                 String           @id @default(cuid())
  transportRequestId String
  truckId            String?
  driverId           String?
  assignedWeight     Float
  assignedQuantity   Int
  status             AssignmentStatus @default(PENDING)
  dispatchedAt       DateTime?
  pickedUpAt         DateTime?
  arrivedAt          DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  transportRequest     TransportRequest      @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  truck                Truck?                @relation(fields: [truckId], references: [id])
  driver               Driver?               @relation(fields: [driverId], references: [id])
  deliveryProgress       DeliveryProgress[]
  assignmentConfirmation AssignmentConfirmation?

  @@index([transportRequestId])
  @@index([truckId])
  @@index([driverId])
  @@index([status])
}

model DeliveryProgress {
  id           String   @id @default(cuid())
  assignmentId String
  latitude     Float
  longitude    Float
  speed        Float?
  heading      Float?
  progress     Float    @default(0)
  etaMinutes   Float?
  updatedAt    DateTime @default(now())

  assignment TruckAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([updatedAt])
}

model AssignmentConfirmation {
  id           String    @id @default(cuid())
  assignmentId String    @unique
  qrToken      String    @unique
  approved     Boolean   @default(false)
  approvedBy   String?
  approvedAt   DateTime?
  customerIp   String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  assignment TruckAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([qrToken])
}

model Vehicle {
  id          String      @id @default(cuid())
  plateNumber String      @unique
  vehicleType VehicleType
  capacity    Float
  companyId   String
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  tripAllocations TripAllocation[]

  @@index([companyId])
  @@index([isAvailable])
}

model Driver {
  id              String       @id @default(cuid())
  name            String
  phone           String?
  licenseNo       String?
  licenseType     LicenseType  @default(STANDARD)
  companyId       String
  userId          String?      @unique
  status          DriverStatus @default(AVAILABLE)
  isAvailable     Boolean      @default(true)
  workingHoursStart String?    @default("08:00")
  workingHoursEnd   String?    @default("18:00")
  currentLat      Float?
  currentLng      Float?
  currentHeading  Float?
  currentSpeed    Float?
  lastLocationAt  DateTime?
  rating          Float        @default(5.0)
  totalDeliveries Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  tripAllocations  TripAllocation[]
  truckAssignments TruckAssignment[]
  gpsHistory       GpsHistory[]
  internalFleetAssignments InternalFleetAssignment[]
  driverSchedules  DriverSchedule[]
  driverTasks      DriverTask[]

  @@index([companyId])
  @@index([status])
  @@index([isAvailable])
}

model TripAllocation {
  id                 String    @id @default(cuid())
  transportRequestId String    @unique
  driverId           String
  vehicleId          String?
  truckId            String?
  dispatchedAt       DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  distanceTraveledKm Float?
  fuelUsedLiters     Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  transportRequest TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  driver           Driver           @relation(fields: [driverId], references: [id])
  vehicle          Vehicle?         @relation(fields: [vehicleId], references: [id])
  truck            Truck?           @relation(fields: [truckId], references: [id])

  @@index([driverId])
  @@index([vehicleId])
  @@index([truckId])
}

// ─── GPS Tracking ────────────────────────────────────────────────────────────

model GpsHistory {
  id                 String   @id @default(cuid())
  driverId           String
  transportRequestId String?
  latitude           Float
  longitude          Float
  speed              Float?
  heading            Float?
  accuracy           Float?
  recordedAt         DateTime @default(now())

  driver           Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transportRequest TransportRequest? @relation(fields: [transportRequestId], references: [id])

  @@index([driverId])
  @@index([transportRequestId])
  @@index([recordedAt])
}

// ─── QR Confirmation & POD ───────────────────────────────────────────────────

model DeliveryConfirmation {
  id                 String    @id @default(cuid())
  token              String    @unique
  transportRequestId String    @unique
  expiresAt          DateTime
  approvedAt         DateTime?
  approvedBy         String?
  customerIp         String?
  qrGeneratedAt      DateTime  @default(now())

  transportRequest TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)

  @@index([token])
}

model ProofOfDelivery {
  id                 String   @id @default(cuid())
  transportRequestId String   @unique
  signatureUrl       String?
  photoUrl           String?
  notes              String?
  confirmedAt        DateTime @default(now())

  transportRequest TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
}

// ─── Subcontract & Notifications ───────────────────────────────────────────────

model SubContractAssignment {
  id                 String   @id @default(cuid())
  transportRequestId String   @unique
  subcontractorId    String
  assignedAt         DateTime @default(now())
  notes              String?

  transportRequest TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  subcontractor    Company          @relation(fields: [subcontractorId], references: [id])

  @@index([subcontractorId])
}

model Notification {
  id                 String           @id @default(cuid())
  type               NotificationType
  title              String
  message            String
  userId             String?
  companyId          String?
  transportRequestId String?
  isRead             Boolean          @default(false)
  metadata           Json?
  createdAt          DateTime         @default(now())

  user             User?             @relation(fields: [userId], references: [id])
  transportRequest TransportRequest? @relation(fields: [transportRequestId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([isRead])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Key Coffee Yokomochi (横持輸送) ───────────────────────────────────────────

enum DeliveryScheduleStatus {
  PLANNED
  TRIPS_CALCULATED
  INTERNAL_SCHEDULING
  CARRIER_PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FactoryResponseStatus {
  FULL
  PARTIAL
  REJECTED
}

enum NegotiationAction {
  APPROVE
  REJECT
  REQUEST_AGAIN
}

enum YokomochiOrderStatus {
  DRAFT
  FACTORY_PENDING
  NEGOTIATING
  APPROVED
  TRIPS_CALCULATED
  INTERNAL_SCHEDULING
  CARRIER_PENDING
  SUBCONTRACTING
  DRIVER_ASSIGNED
  IN_PROGRESS
  AWAITING_VERIFICATION
  COMPLETED
  CANCELLED
}

enum YokomochiTripStatus {
  PLANNED
  INTERNAL_ASSIGNED
  CARRIER_ASSIGNED
  SUBCONTRACT_ASSIGNED
  DRIVER_ASSIGNED
  IN_PROGRESS
  ARRIVED_WAREHOUSE
  VERIFIED
  COMPLETED
  CANCELLED
}

enum DriverTaskStatus {
  ASSIGNED
  ARRIVED_FACTORY
  LOADED_CARGO
  IN_TRANSIT
  ARRIVED_WAREHOUSE
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CarrierRequestStatus {
  PENDING
  ACCEPTED
  PARTIAL
  REJECTED
}

/// Parent order — never deleted, all history preserved
model YokomochiOrder {
  id              String               @id @default(cuid())
  orderNo         String               @unique
  status          YokomochiOrderStatus @default(DRAFT)
  cargoType       String?
  productName     String?
  totalTrips      Int                  @default(0)
  remainderPallets Int                 @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  completedAt     DateTime?

  factoryRequest   FactoryRequest?
  factoryResponse  FactoryResponse?
  factoryNegotiation FactoryNegotiation?
  deliverySchedules DeliverySchedule[]
  negotiationHistory NegotiationHistory[]
  negotiationChatMessages NegotiationChatMessage[]
  trips            YokomochiTrip[]
  carrierRequests  CarrierRequest[]
  deliveryVerification DeliveryVerification?
  deliveryForm     YokomochiDeliveryForm?

  @@index([status])
  @@index([createdAt])
}

model FactoryRequest {
  id                 String   @id @default(cuid())
  yokomochiOrderId   String   @unique
  warehouseCompanyId String
  factoryCompanyId   String
  createdById        String?
  requestedQuantity  Int
  requestedPallets   Int
  requestedBoxes     Int
  requestedDate      DateTime
  cargoType          String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  yokomochiOrder   YokomochiOrder @relation(fields: [yokomochiOrderId], references: [id], onDelete: Cascade)
  warehouseCompany Company        @relation("FactoryRequestWarehouse", fields: [warehouseCompanyId], references: [id])
  factoryCompany   Company        @relation("FactoryRequestFactory", fields: [factoryCompanyId], references: [id])
  createdBy        User?          @relation("FactoryRequestCreator", fields: [createdById], references: [id])
  factoryNegotiation FactoryNegotiation?
  deliverySchedules  DeliverySchedule[]

  @@index([warehouseCompanyId])
  @@index([factoryCompanyId])
  @@index([createdAt])
}

model FactoryResponse {
  id                 String                @id @default(cuid())
  yokomochiOrderId   String                @unique
  availableQuantity  Int
  availablePallets   Int
  availableBoxes     Int
  availableDate      DateTime
  negotiationStatus  FactoryResponseStatus
  notes              String?
  respondedAt        DateTime              @default(now())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  yokomochiOrder YokomochiOrder @relation(fields: [yokomochiOrderId], references: [id], onDelete: Cascade)

  @@index([negotiationStatus])
}

/// Real logistics negotiation — preserves original request + partial remainder
model FactoryNegotiation {
  id                String                @id @default(cuid())
  factoryRequestId  String                @unique
  yokomochiOrderId  String                @unique
  requestedBoxes    Int
  availableBoxes    Int
  remainingBoxes    Int                   @default(0)
  availableDate     DateTime
  nextAvailableDate DateTime?
  status            FactoryResponseStatus
  notes             String?
  respondedAt       DateTime              @default(now())
  approvedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  factoryRequest FactoryRequest @relation(fields: [factoryRequestId], references: [id], onDelete: Cascade)
  yokomochiOrder YokomochiOrder @relation(fields: [yokomochiOrderId], references: [id], onDelete: Cascade)

  @@index([status])
}

model DeliverySchedule {
  id               String                 @id @default(cuid())
  factoryRequestId String
  yokomochiOrderId String
  scheduleNo       Int
  deliveryDate     DateTime
  boxes            Int
  pallets          Int
  totalTrips       Int                    @default(0)
  status           DeliveryScheduleStatus @default(PLANNED)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  factoryRequest  FactoryRequest   @relation(fields: [factoryRequestId], references: [id], onDelete: Cascade)
  yokomochiOrder  YokomochiOrder   @relation(fields: [yokomochiOrderId], references: [id], onDelete: Cascade)
  trips           YokomochiTrip[]
  carrierRequests CarrierRequest[]

  @@unique([yokomochiOrderId, scheduleNo])
  @@index([factoryRequestId])
  @@index([deliveryDate])
}

model NegotiationChatMessage {
  id               String   @id @default(cuid())
  yokomochiOrderId String
  senderUserId     String
  senderRole       UserRole
  senderCompanyId  String
  message          String
  createdAt        DateTime @default(now())

  yokomochiOrder YokomochiOrder @relation(fields: [yokomochiOrderId], references: [id], onDelete: Cascade)
  sender         User           @relation("NegotiationChatSender", fields: [senderUserId], references: [id])

  @@index([yokomochiOrderId, createdAt])
}

model NegotiationHistory {
  id               String              @id @default(cuid())
  yokomochiOrderId String
  action           NegotiationAction
  actorUserId      String?
  actorRole        UserRole?
  message          String?
  requestedPallets Int?
  offeredPallets   Int?
  createdAt        DateTime            @default(now())

  yokomochiOrder YokomochiOrder @relation(fields: [yokomochiOrderId], references: [id], onDelete: Cascade)
  actor          User?          @relation(fields: [actorUserId], references: [id])

  @@index([yokomochiOrderId])
  @@index([createdAt])
}

model YokomochiTrip {
  id                 String              @id @default(cuid())
  yokomochiOrderId   String
  deliveryScheduleId String?
  scheduledDate      DateTime?
  tripNo             Int
  tripCode           String
  pallets            Int                 @default(16)
  boxes              Int                 @default(0)
  status             YokomochiTripStatus @default(PLANNED)
  carrierCompanyId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  yokomochiOrder           YokomochiOrder                  @relation(fields: [yokomochiOrderId], references: [id], onDelete: Cascade)
  deliverySchedule         DeliverySchedule?               @relation(fields: [deliveryScheduleId], references: [id], onDelete: SetNull)
  carrierCompany           Company?                        @relation(fields: [carrierCompanyId], references: [id])
  internalFleetAssignment  InternalFleetAssignment?
  driverSchedule           DriverSchedule?
  driverTask               DriverTask?
  subcontractAssignment    YokomochiSubcontractAssignment?

  @@unique([yokomochiOrderId, tripNo])
  @@index([yokomochiOrderId])
  @@index([deliveryScheduleId])
  @@index([scheduledDate])
  @@index([status])
}

model InternalFleetAssignment {
  id        String   @id @default(cuid())
  tripId    String   @unique
  truckId   String
  driverId  String
  tripCount Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip   YokomochiTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  truck  Truck         @relation(fields: [truckId], references: [id])
  driver Driver        @relation(fields: [driverId], references: [id])

  @@index([truckId])
  @@index([driverId])
}

model DriverSchedule {
  id        String   @id @default(cuid())
  tripId    String   @unique
  driverId  String
  truckId   String
  startTime DateTime
  endTime   DateTime
  label     String?
  isLunch   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip   YokomochiTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver Driver        @relation(fields: [driverId], references: [id])
  truck  Truck         @relation(fields: [truckId], references: [id])

  @@index([driverId])
  @@index([startTime])
}

model CarrierRequest {
  id                 String               @id @default(cuid())
  yokomochiOrderId   String
  deliveryScheduleId String?
  warehouseCompanyId String
  carrierCompanyId   String
  deliveryDate       DateTime?
  requestedTrips     Int
  status             CarrierRequestStatus @default(PENDING)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  yokomochiOrder   YokomochiOrder    @relation(fields: [yokomochiOrderId], references: [id], onDelete: Cascade)
  deliverySchedule DeliverySchedule? @relation(fields: [deliveryScheduleId], references: [id], onDelete: SetNull)
  warehouseCompany Company           @relation("CarrierRequestWarehouse", fields: [warehouseCompanyId], references: [id])
  carrierCompany   Company           @relation("CarrierRequestCarrier", fields: [carrierCompanyId], references: [id])
  response         CarrierResponse?

  @@index([yokomochiOrderId])
  @@index([deliveryScheduleId])
  @@index([carrierCompanyId])
  @@index([status])
  @@index([deliveryDate])
}

model CarrierResponse {
  id                  String   @id @default(cuid())
  carrierRequestId    String   @unique
  availableTrips      Int
  truckCount          Int
  driverCount         Int
  truckInfo           String?
  driverInfo          String?
  estimatedPickupTime DateTime?
  notes               String?
  respondedAt         DateTime @default(now())
  createdAt           DateTime @default(now())

  carrierRequest CarrierRequest @relation(fields: [carrierRequestId], references: [id], onDelete: Cascade)
}

model YokomochiSubcontractAssignment {
  id                String   @id @default(cuid())
  tripId            String   @unique
  subcontractorId   String
  assignedTrips     Int      @default(1)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trip          YokomochiTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  subcontractor Company       @relation(fields: [subcontractorId], references: [id])

  @@index([subcontractorId])
}

model DriverTask {
  id               String           @id @default(cuid())
  tripId           String           @unique
  driverId         String
  truckId          String?
  status           DriverTaskStatus @default(ASSIGNED)
  pickupLocation   String
  destination      String
  cargoType        String?
  boxes            Int              @default(0)
  pallets          Int              @default(0)
  eta              DateTime?
  arrivedFactoryAt DateTime?
  loadedAt         DateTime?
  startedAt        DateTime?
  arrivedWarehouseAt DateTime?
  completedAt      DateTime?
  qrToken          String?          @unique
  qrExpiresAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  trip   YokomochiTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver Driver        @relation(fields: [driverId], references: [id])
  truck  Truck?        @relation(fields: [truckId], references: [id])

  @@index([driverId])
  @@index([status])
  @@index([qrToken])
  @@index([createdAt])
}

model DeliveryVerification {
  id                 String             @id @default(cuid())
  yokomochiOrderId   String             @unique
  verifiedQuantity   Int?
  verifiedPallets    Int?
  verifiedBoxes      Int?
  truckInfo          String?
  driverInfo         String?
  status             VerificationStatus @default(PENDING)
  notes              String?
  verifiedByUserId   String?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  yokomochiOrder YokomochiOrder @relation(fields: [yokomochiOrderId], references: [id], onDelete: Cascade)
}

/// Digital 横持輸送依頼書 / 確認書
model YokomochiDeliveryForm {
  id               String    @id @default(cuid())
  yokomochiOrderId String    @unique
  deliveryNo       String    @unique
  driverName       String?
  truckInfo        String?
  cargoType        String?
  boxes            Int       @default(0)
  pallets          Int       @default(0)
  arrivalTime      DateTime?
  verificationNote String?
  approvedBy       String?
  completedTime    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  yokomochiOrder YokomochiOrder @relation(fields: [yokomochiOrderId], references: [id], onDelete: Cascade)
}
