# Database - RDS PostgreSQL with connection pooling (PgBouncer via Prisma)
DATABASE_URL="postgresql://mtms_admin:CHANGE_ME@localhost:5433/mtms?schema=public&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://mtms_admin:CHANGE_ME@localhost:5433/mtms?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# AWS
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="mtms-uploads-dev"
OPENROUTESERVICE_API_KEY=""
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Node
NODE_ENV="development"
